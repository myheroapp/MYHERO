rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 1. Fotos públicas de perfil de Héroes y Ciudadanos (visibles en el catálogo, editables solo por su dueño)
    match /heroes/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || (
                        request.resource.size < 5 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')
                      ));
    }

    // 2. Carpeta personal de cada usuario (avatares y archivos propios)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // 3. Bloquear cualquier otra ruta no autorizada por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
