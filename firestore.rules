rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (Heroly España)
    // - users/{userId}: Private owner-only profile (contains PII: email, phone)
    // - heroes/{heroId}: Public Hero catalog (no PII allowed)
    // - missions/{missionId}: Public citizen announcements (no PII allowed)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && 'uid' in resource.data && resource.data.uid == request.auth.uid;
    }

    function uidMatchesAuth() {
      return 'uid' in request.resource.data && request.resource.data.uid is string && request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function createdAtNotModified() {
      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidPhoto(photo) {
      return photo is string && photo.size() <= 950000;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'role']) &&
        !data.keys().hasAny(['isAdmin', 'admin', 'permissions']) &&
        data.uid is string && data.uid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role in ['ciudadano', 'hero'] &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 3000)) &&
        (!('age' in data) || (data.age is number && data.age >= 18 && data.age <= 110)) &&
        (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 3)) &&
        (!('rate' in data) || (data.rate is number && data.rate >= 1 && data.rate <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidCatalogProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'city', 'level', 'rate']) &&
        data.keys().hasOnly([
          'uid', 'id', 'name', 'age', 'city', 'zone', 'level', 'levelLabel',
          'rate', 'rating', 'reviewsCount', 'experience', 'online', 'isOnlineNow',
          'photo', 'shortBio', 'fullBio', 'daysAvailable', 'schedule',
          'missions', 'experienceCards', 'capabilities', 'references', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
        data.level is number && data.level >= 1 && data.level <= 3 &&
        data.rate is number && data.rate >= 1 && data.rate <= 200 &&
        (!('age' in data) || (data.age is number && data.age >= 18 && data.age <= 110)) &&
        (!('zone' in data) || (data.zone is string && data.zone.size() <= 120)) &&
        (!('levelLabel' in data) || (data.levelLabel is string && data.levelLabel.size() <= 100)) &&
        (!('rating' in data) || (data.rating is string && data.rating.size() <= 10)) &&
        (!('reviewsCount' in data) || (data.reviewsCount is number && data.reviewsCount >= 0 && data.reviewsCount <= 100000)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 150)) &&
        (!('online' in data) || (data.online is string && data.online.size() <= 60)) &&
        (!('isOnlineNow' in data) || data.isOnlineNow is bool) &&
        (!('photo' in data) || isValidPhoto(data.photo)) &&
        (!('shortBio' in data) || (data.shortBio is string && data.shortBio.size() <= 1000)) &&
        (!('fullBio' in data) || (data.fullBio is string && data.fullBio.size() <= 3000)) &&
        (!('daysAvailable' in data) || (data.daysAvailable is list && data.daysAvailable.size() <= 7)) &&
        (!('schedule' in data) || data.schedule is map) &&
        (!('missions' in data) || (data.missions is list && data.missions.size() <= 20)) &&
        (!('experienceCards' in data) || (data.experienceCards is list && data.experienceCards.size() <= 20)) &&
        (!('capabilities' in data) || (data.capabilities is list && data.capabilities.size() <= 20)) &&
        (!('references' in data) || (data.references is list && data.references.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidHero(data) {
      return isValidCatalogProfile(data);
    }

    function isValidMission(data) {
      return isValidCatalogProfile(data) && 'shortBio' in data;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && uidNotModified() && createdAtNotModified() && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    match /heroes/{heroId} {
      allow read: if true;
      allow create: if isAuthenticated() && uidMatchesAuth() && isValidHero(request.resource.data);
      allow update: if isAuthenticated() && (isDocOwner() || isOwner(heroId)) && uidMatchesAuth() && uidNotModified() && createdAtNotModified() && isValidHero(request.resource.data);
      allow delete: if isAuthenticated() && (isDocOwner() || isOwner(heroId));
    }

    match /missions/{missionId} {
      allow read: if true;
      allow create: if isAuthenticated() && uidMatchesAuth() && isValidMission(request.resource.data);
      allow update: if isAuthenticated() && isDocOwner() && uidMatchesAuth() && uidNotModified() && createdAtNotModified() && isValidMission(request.resource.data);
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
